# ============================================================
# 쉼터 1365 활동일지 자동화 - 설정값 목록 (예시 파일)
#
# - 이 파일은 "무엇을 준비해야 하는지" 정리한 체크리스트입니다.
# - 실제 값은 Apps Script의 [프로젝트 설정 → 스크립트 속성]에 입력합니다.
#   (코드는 .env를 읽지 않습니다.)
# - 실제 값을 적어 둘 로컬 메모가 필요하면 `.env`로 복사해서 쓰세요.
#   `.env`는 .gitignore에 들어 있어 커밋되지 않습니다.
# - 이 파일(.env.example)에는 절대 실제 값을 넣지 마세요.
#
# 표시: [비밀] 유출되면 안 되는 값 / [ID] 구글 ID / [선택] 비워도 동작
# 언제: 괄호 안은 docs/TASKS.md의 단계 번호
# ============================================================


# ------------------------------------------------------------
# 1. 텔레그램 (3단계)
# ------------------------------------------------------------
# [비밀] BotFather에서 봇 생성 후 받는 토큰
TELEGRAM_BOT_TOKEN=
# 운영진 그룹 chat ID (음수, 예: -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=
# 버튼·명령을 허용할 운영진 user ID (쉼표 구분, 예: 11111,22222)
ADMIN_USER_IDS=
# [비밀] 웹훅 검증용 임의의 긴 문자열 (직접 생성, 예: openssl rand -hex 24)
WEBHOOK_SECRET=
# 웹앱 URL (setWebhook()이 텔레그램에 등록할 주소, Vercel 환경변수 WEBAPP_URL과 같은 값)
WEBAPP_URL=


# ------------------------------------------------------------
# 2. LLM - 자연어 수정 (7단계)
# ------------------------------------------------------------
# [비밀] Gemini API 키 (무료 티어 사용, 개인정보는 코드에서 마스킹 후 전송)
LLM_API_KEY=
# 사용할 모델명
LLM_MODEL=


# ------------------------------------------------------------
# 3. 쉼터 위치 - 지오펜스 (1~2단계)
# ------------------------------------------------------------
# 쉼터 좌표 (위도/경도, 소수점 6자리 정도)
SHELTER_LAT=
SHELTER_LNG=
# 허용 반경(m). 기본 300
GEOFENCE_RADIUS_M=300


# ------------------------------------------------------------
# 4. 폼 (1~2단계)
# ------------------------------------------------------------
# 활동시간 선택 방식: free(시작·종료 시각 자유 선택) / preset(오전·오후·종일 중 하나)
TIME_MODE=free
# [free] 시작·종료 시각을 고를 수 있는 범위 (10분 단위, HH:mm~HH:mm)
ACTIVITY_WINDOW=10:00~18:00
# [free] 한 번에 신청할 수 있는 최대 활동시간 (시간)
MAX_ACTIVITY_HOURS=8
# [preset] 오전·오후·종일 시간 (HH:mm~HH:mm)
TIME_MORNING=10:00~14:00
TIME_AFTERNOON=14:00~18:00
TIME_FULLDAY=10:00~18:00


# ------------------------------------------------------------
# 5. 활동일지 고정값 (4단계)
# ------------------------------------------------------------
# 활동기관·기관명
ORG_NAME=
# 활동내용(공통)
ACTIVITY_DESC=
# 담당자 이름·연락처
MANAGER_NAME=
MANAGER_PHONE=


# ------------------------------------------------------------
# 6. 구글 드라이브·시트 ID (1, 2, 4단계)
#    URL에서 복사: .../d/<여기가 ID>/edit, .../folders/<여기가 ID>
# ------------------------------------------------------------
# [ID] 데이터 시트 (신청/주차/대화상태/처리로그 탭)
SHEET_ID=
# [ID] 활동일지 양식 템플릿 시트
TEMPLATE_SHEET_ID=
# [ID] PDF 저장 폴더
DRIVE_FOLDER_ID=
# [ID] 직인 이미지 파일 (드라이브에 업로드)
SEAL_IMAGE_FILE_ID=
# [ID] 봉사자 전자서명 저장 폴더 (2단계, 링크 공유 금지)
SIGNATURE_FOLDER_ID=


# ------------------------------------------------------------
# 7. 메일 발송 (6단계)
#    테스트 중에는 MAIL_TO를 본인 메일로 두세요.
# ------------------------------------------------------------
# 수신자 (자원봉사센터 담당자)
MAIL_TO=
# [선택] 참조 (쉼표 구분)
MAIL_CC=
# 치환 변수: {org} {start} {end} {count} {sent_date}
MAIL_SUBJECT=[{org}] 자원봉사 활동일지 제출 ({start}~{end})
MAIL_BODY=
PDF_FILENAME={end}_{org}_활동일지.pdf


# ------------------------------------------------------------
# 8. 개인정보 파기 (8단계)
# ------------------------------------------------------------
# 발송 후 보관 개월 수
RETENTION_MONTHS=3


# ============================================================
# 아래는 Script Properties가 아니라 배포·개발 과정에서 필요한 값입니다.
# (코드가 읽지 않으며, 본인이 메모해 두는 용도)
# ============================================================

# clasp 프로젝트의 스크립트 ID (.clasp.json에 들어가며 .gitignore 대상)
CLASP_SCRIPT_ID=
# 웹앱 배포 ID (clasp deploy -i <배포ID>로 URL 유지)
DEPLOYMENT_ID=
# 폼을 호스팅하는 주소 (QR 코드용)
FORM_URL=
